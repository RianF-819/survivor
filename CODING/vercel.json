{
  "version": 2,
  "name": "pixel-survivor",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/audio/(.*)\\.flac",
      "headers": [
        {
          "key": "Content-Type",
          "value": "audio/flac"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
